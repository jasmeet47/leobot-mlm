APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=ADMIN
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=

# Remain OFF until the approved staking lifecycle and production funding are verified.
LUMIFLOWON_PRODUCTION_FINANCIAL_APPROVAL=false
LUMIFLOWON_STAKING_ENABLED=false

LUMIFLOWON_DEPOSITS_ENABLED=false
LUMIFLOWON_WITHDRAWALS_ENABLED=false
LUMIFLOWON_WITHDRAWAL_POLICY_ENABLED=false
LUMIFLOWON_STAKING_PROFIT_ENABLED=false
LUMIFLOWON_USDT_RPC_ENABLED=false
LUMIFLOWON_PAYMENT_VERIFICATION_ENABLED=false
LEOBOT_BSC_RPC_URL=
LEOBOT_TRON_FULL_NODE_URL=
LEOBOT_TRON_SOLIDITY_NODE_URL=
LUMIFLOWON_BEP20_DEPOSIT_ADDRESS=
LUMIFLOWON_TRC20_DEPOSIT_ADDRESS=
